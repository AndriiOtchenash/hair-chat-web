# Copy to .env.local to override .env.development locally (never commit secrets: a SPA has none).
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
# Base path of the API as seen by the browser; /api is proxied by Vite to FastAPI in dev.
VITE_API_BASE_URL=/api
# Where the Vite dev proxy forwards /api (read by vite.config.ts, not by the browser).
VITE_API_PROXY_TARGET=http://localhost:8000
