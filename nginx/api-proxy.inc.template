# Included in every /api location: /api/x -> ${API_UPSTREAM}/x over Flycast (private network).
# Timeouts are set by each location (SSE needs a longer read timeout than plain calls).

# Fly's internal DNS; .flycast has AAAA records only. proxy_pass with a variable makes
# nginx resolve the name at request time (and again after `valid`) instead of once at start.
resolver [fdaa::3]:53 ipv4=off valid=30s;
resolver_timeout 5s;
set $api_upstream ${API_UPSTREAM};
rewrite ^/api/(.*)$ /$1 break;
proxy_pass $api_upstream;

proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;

# Unbuffered so SSE events pass through as they arrive.
proxy_http_version 1.1;
proxy_set_header Connection "";
proxy_buffering off;
proxy_cache off;

# A cold or dead API fails fast instead of hanging until the read timeout.
proxy_connect_timeout 10s;
proxy_send_timeout 60s;
