# Rendered by the nginx image entrypoint (envsubst of ${AUTH0_DOMAIN} and ${API_UPSTREAM} only).
server {
    listen 8080;
    listen [::]:8080;
    server_name _;

    root /usr/share/nginx/html;
    server_tokens off;
    # Fly terminates TLS; redirects must not point at :8080.
    absolute_redirect off;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    # text/html is always on. text/event-stream is deliberately absent, and gzip_proxied stays
    # off, so the SSE stream from /api is never compressed (and so never buffered).
    gzip_types text/css text/plain application/javascript application/json image/svg+xml;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Hashed file names: a new release gets new URLs, so these can be cached forever.
    location /assets/ {
        include /etc/nginx/conf.d/security-headers.inc;
        # No `always`: a 404 must not be cached for a year.
        add_header Cache-Control "public, max-age=31536000, immutable";
        # A missing chunk is a 404, never index.html served as JavaScript.
        try_files $uri =404;
    }

    location = /index.html {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
    }

    # SPA fallback: client-side routes (/chat/123, /settings, ...) get index.html.
    location / {
        include /etc/nginx/conf.d/security-headers.inc;
        try_files $uri /index.html;
    }

    # Same-origin API: /api/x -> ${API_UPSTREAM}/x over Flycast (private network).
    location /api/ {
        # Fly's internal DNS; .flycast has AAAA records only. proxy_pass with a variable makes
        # nginx resolve the name at request time (and again after `valid`) instead of once at start.
        resolver [fdaa::3]:53 ipv4=off valid=30s;
        resolver_timeout 5s;
        set $api_upstream ${API_UPSTREAM};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;

        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;

        # SSE (POST /conversations/{id}/messages): pass events through as they arrive.
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
