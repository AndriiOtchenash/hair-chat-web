# Rendered by the nginx image entrypoint (envsubst of ${AUTH0_DOMAIN} and ${API_UPSTREAM} only).
server {
    listen 8080;
    listen [::]:8080;
    server_name _;

    root /usr/share/nginx/html;
    server_tokens off;
    # Fly terminates TLS; redirects must not point at :8080.
    absolute_redirect off;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    # text/html is always on. text/event-stream is deliberately absent, and gzip_proxied stays
    # off, so the SSE stream from /api is never compressed (and so never buffered).
    gzip_types text/css text/plain application/javascript application/json image/svg+xml;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Hashed file names: a new release gets new URLs, so these can be cached forever.
    location /assets/ {
        include /etc/nginx/conf.d/security-headers.inc;
        # No `always`: a 404 must not be cached for a year.
        add_header Cache-Control "public, max-age=31536000, immutable";
        # A missing chunk is a 404, never index.html served as JavaScript.
        try_files $uri =404;
    }

    location = /index.html {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
    }

    # SPA fallback: client-side routes (/chat/123, /settings, ...) get index.html.
    location / {
        include /etc/nginx/conf.d/security-headers.inc;
        try_files $uri /index.html;
    }

    # Same-origin API. Plain calls: 60 s for the API to answer.
    location /api/ {
        include /etc/nginx/conf.d/api-proxy.inc;
        proxy_read_timeout 60s;
    }

    # SSE (POST /conversations/{id}/messages): a long answer may take minutes. Only POST gets
    # 300 s; GET of the same path (message history) goes to @api with the plain 60 s.
    location ~ ^/api/conversations/[^/]+/messages$ {
        error_page 418 = @api;
        if ($request_method != POST) {
            return 418;
        }
        include /etc/nginx/conf.d/api-proxy.inc;
        proxy_read_timeout 300s;
    }

    location @api {
        include /etc/nginx/conf.d/api-proxy.inc;
        proxy_read_timeout 60s;
    }
}
