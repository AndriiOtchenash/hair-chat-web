# Included in every location that sends a page or asset. nginx drops server-level add_header
# directives in a location that has its own add_header, so they live here instead.
#
# CSP exceptions beyond 'self':
# - connect-src Auth0: /oauth/token (refresh tokens) is called with fetch.
# - frame-src Auth0: silent auth (prompt=none iframe) restores the session after a reload.
# - worker-src blob: auth0-spa-js runs refresh-token requests in a Worker built from a blob URL.
# - style-src 'unsafe-inline': sonner and Radix (scroll lock) inject <style> elements at runtime.
#   Scripts stay 'self' only.
add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://${AUTH0_DOMAIN}; frame-src https://${AUTH0_DOMAIN}; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
